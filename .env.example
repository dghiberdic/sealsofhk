# Optional: bake an Anthropic API key into the build so the photo-extraction
# demo works without anyone pasting a key. Copy this file to `.env.local`
# (which is git-ignored) and fill it in.
#
# WARNING: any key in a client-side Vite build ships to the browser and is
# visible to anyone using the app. Use a scoped/disposable key for demos, and
# never commit a real one. If you leave this unset, the app asks the user to
# paste their own key at upload time (stored only in their browser).
VITE_ANTHROPIC_API_KEY=

# Optional: override the vision model. Defaults to claude-haiku-4-5 (cheap +
# fast, fine for printed lab reports). Bump to claude-sonnet-4-6 for tougher /
# low-light photos, or claude-opus-4-8 for maximum accuracy.
VITE_ANTHROPIC_MODEL=

# Optional: Telegram carer alerts. Set these to pre-fill the bot token + the
# carer's chat id so alerts work without typing them into Settings.
#   VITE_TG_BOT_TOKEN — from @BotFather (e.g. 8123456789:AA...)
#   VITE_TG_CHAT_ID   — the carer's numeric chat id (or a negative group id)
# WARNING: Vite inlines VITE_* values into the shipped JS, so a token set here
# is visible to anyone using the deployed app — use a throwaway bot. Leaving
# these blank just means the user enters them in Settings (stored per browser).
VITE_TG_BOT_TOKEN=
VITE_TG_CHAT_ID=
